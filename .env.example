# Copy this file to .env and fill in your own values. .env is gitignored, so
# your real credentials never get committed.

# Only needed if you ever enable live LinkedIn/Indeed scraping -- both are
# explicitly gated off by default (see README.md), leave empty until you've
# tested that flow yourself and are comfortable enabling it.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
INDEED_EMAIL=
INDEED_PASSWORD=

# Anthropic API key, used for letter generation and (optionally) other Claude
# calls. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Telegram bot token + your own chat id, used for approval requests and
# receiving generated letters. Create a bot via @BotFather on Telegram to get
# a token; message your own bot once, then check
# https://api.telegram.org/bot<token>/getUpdates for your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# DRY_RUN=true mocks the letter-generation Claude call and skips real Telegram
# sends -- safe to leave on while you're setting things up, no API costs.
DRY_RUN=true
# SCRAPE_LIVE=false only uses the sample fixtures in tests/sample_data/,
# instead of live-scraping the companies in companies.yaml.
SCRAPE_LIVE=false
